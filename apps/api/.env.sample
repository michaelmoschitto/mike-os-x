# Docker Configuration
# DOCKER_HOST is auto-detected, but can be overridden here
# For macOS: unix:///Users/your-username/.docker/run/docker.sock
# For Linux/Containers: unix:///var/run/docker.sock
# DOCKER_HOST=unix:///var/run/docker.sock

# Terminal Container Configuration
TERMINAL_CONTAINER_NAME=terminal-shared
TERMINAL_VOLUME_NAME=terminal-workspace

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
# Generate a strong random key for production
ADMIN_API_KEY=dev-admin-key-123

# CORS Origins (comma-separated)
# Allow requests from these origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Production terminal agent (leave unset for local Docker)
# TERMINAL_AGENT_URL=https://agent.os.mikemoschitto.com
# TERMINAL_AGENT_TOKEN=replace-with-a-32-plus-character-secret

# Rate Limiting
RATE_LIMIT_CONNECTIONS=50
RATE_LIMIT_COMMANDS=5000

# Container Resources
CONTAINER_MEMORY=256m
CONTAINER_CPUS=0.5
CONTAINER_PIDS=128
CONTAINER_DISK=64m
MAX_TERMINAL_SESSIONS=2
MAX_SESSIONS_PER_CONNECTION=1
