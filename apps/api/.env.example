# Example environment variables for API (Backend)
# Copy this file to .env.local and fill in the values

# CORS origins - comma-separated list (REQUIRED)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Docker configuration (for local development, uses local Docker socket)
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_TLS_VERIFY=0

# Redis URL (optional for local, uses default if not set)
# REDIS_URL=redis://localhost:6379/0

# Admin API key (only required in production)
# ADMIN_API_KEY=your-secret-key-here

# Production terminal agent (leave unset for local Docker)
# TERMINAL_AGENT_URL=https://agent.os.mikemoschitto.com
# TERMINAL_AGENT_TOKEN=replace-with-a-32-plus-character-secret
