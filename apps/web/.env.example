# Example environment variables for Web (Frontend)
# Copy this file to .env.local and fill in the values

# API URL for websocket connections (REQUIRED)
# Local development: http://localhost:8000
# Production: https://api.os.mikemoschitto.com
VITE_API_URL=http://localhost:8000

# SHA-256 digest used by the Selected Work presentation gate
# Generate with: bun run portfolio:hash-password
VITE_PORTFOLIO_PASSWORD_HASH=
